generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         String   @id @default(uuid())
  login      String   @unique
  password   String
  role       String
  teacher_id String?  @unique
  student_id String?  @unique
  
  teacher    Teacher? @relation(fields: [teacher_id], references: [id])
  student    Student? @relation(fields: [student_id], references: [id])
}

model Teacher {
  id       String   @id @default(uuid())
  name     String
  user     User?
  lessons  Lesson[]
}

model Group {
  id       String    @id @default(uuid())
  name     String
  students Student[]
  lessons  Lesson[]
}

model Subject {
  id       String   @id @default(uuid())
  name     String
  lessons  Lesson[]
}

model Student {
  id         String       @id @default(uuid())
  name       String
  group_id   String
  group      Group        @relation(fields: [group_id], references: [id])
  user       User?
  marks      Mark[]
  attendance Attendance[]
}

model Lesson {
  id            String       @id @default(uuid())
  teacher_id    String
  group_id      String
  subject_id    String
  date          DateTime
  lesson_number Int
  lesson_type   String?
  
  teacher       Teacher      @relation(fields: [teacher_id], references: [id])
  group         Group        @relation(fields: [group_id], references: [id])
  subject       Subject      @relation(fields: [subject_id], references: [id])
  marks         Mark[]
  attendance    Attendance[]
}

model Mark {
  id         String  @id @default(uuid())
  mark       String
  student_id String
  lesson_id  String
  
  student    Student @relation(fields: [student_id], references: [id])
  lesson     Lesson  @relation(fields: [lesson_id], references: [id])

  @@unique([student_id, lesson_id])
}

model Attendance {
  id             String  @id @default(uuid())
  student_id     String
  lesson_id      String
  absence_reason String
  
  student        Student @relation(fields: [student_id], references: [id])
  lesson         Lesson  @relation(fields: [lesson_id], references: [id])

  @@unique([student_id, lesson_id])
}